---
import { outsideWork } from "@/data/outsideWork";
import { getReadingDays } from "@/data/goodreads";
import Goodreads from "@/assets/social-icons/goodreads-g.svg";
import Heatmap from "./Heatmap.astro";

const goodreadsUrl =
  "https://www.goodreads.com/user/show/152478889-jania-vandevoorde";

const readingDays = await getReadingDays();
---

<dialog id="outside-work-modal" class="modal">
  <div class="modal-box max-w-2xl bg-base-100 rounded-lg p-8 shadow-none border border-base-300">
    <form method="dialog">
      <button
        class="absolute right-5 top-5 text-base-content/60 hover:text-base-content transition-colors"
        aria-label="Close"
      >
        ✕
      </button>
    </form>
    <h2 class="text-2xl font-semibold tracking-tight mb-6">Outside work</h2>
    <div class="divide-y divide-base-300">
      {
        outsideWork.map((section) => (
          <section class="py-5 first:pt-0 last:pb-0">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-base-content/60 mb-2">
              {section.title}
            </h3>
            {section.description && (
              <p class="text-sm leading-relaxed text-base-content/80">
                {section.description}
              </p>
            )}
            {section.bullets && section.bullets.length > 0 && (
              <ul class="flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-base-content/80">
                {section.bullets.map((bullet) => (
                  <li>
                    <span aria-hidden="true" class="mr-1">
                      {bullet.emoji}
                    </span>
                    {bullet.label}
                  </li>
                ))}
              </ul>
            )}
            {section.title === "Hobbies" && readingDays.size > 0 && (
              <div class="mt-5">
                <h4 class="mb-2 flex items-center gap-2 text-sm font-medium">
                  Days reading
                  <a
                    href={goodreadsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Goodreads"
                    class="text-base-content/60 hover:text-secondary transition-colors"
                  >
                    <Goodreads class="size-4" fill="currentColor" />
                  </a>
                </h4>
                <Heatmap counts={readingDays} unit="days reading" />
              </div>
            )}
            {section.links && section.links.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
                {section.links.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm underline underline-offset-4 decoration-secondary decoration-2 hover:text-secondary transition-colors"
                  >
                    {link.label} ↗
                  </a>
                ))}
              </div>
            )}
            {section.images.length > 0 && (
              <div class="mt-4 grid grid-cols-2 gap-3">
                {section.images.map((image) => (
                  <img
                    src={image.src}
                    alt={image.alt}
                    loading="lazy"
                    class="w-full rounded-md object-cover"
                  />
                ))}
              </div>
            )}
          </section>
        ))
      }
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button aria-label="Close">close</button>
  </form>
</dialog>

<script>
  document.addEventListener("click", (event) => {
    const trigger = (event.target as Element).closest("[data-open-outside-work]");
    if (!trigger) return;
    document
      .querySelector<HTMLDialogElement>("#outside-work-modal")
      ?.showModal();
  });
</script>
