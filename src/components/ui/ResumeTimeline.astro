---
import { isExperience } from "@/types/resume";
import type { Experience, Education } from "@/types/resume";
import Tooltip from "./Tooltip.astro";

interface Props {
  elements: (Experience | Education)[];
  colored: boolean;
}

const { elements, colored } = Astro.props;

const tagStyles: Record<string, string> = {
  python: "bg-violet-500",
  pytorch: "bg-violet-400",
  tensorflow: "bg-violet-300",
  r: "bg-cyan-500",
  typescript: "bg-amber-500",
  ocaml: "bg-orange-500",
  java: "bg-red-500",
  csharp: "bg-red-400",
  "c#": "bg-red-400",
  mongodb: "bg-emerald-500",
  sql: "bg-emerald-400",
  lean: "bg-slate-500",
  default: "bg-primary",
};

const getTagStyle = (tag: string) => {
  return tagStyles[tag.toLowerCase()] ?? tagStyles.default;
};

const formatTagLabel = (tag: string) => {
  return tag.toLowerCase() === "csharp" ? "C#" : tag;
};
---

<ul
  class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical"
>
  {
    elements.map((element, index) => {
      const isLeft = index % 2 === 0;
      const isHiddenExperience = isExperience(element) && !element.technical;
      return (
        <li
          data-experience-technical={
            isExperience(element) ? String(element.technical) : undefined
          }
          class:list={[
            "group transition-transform duration-200 cursor-pointer",
            { hidden: isHiddenExperience },
          ]}
        >
          <div class="timeline-middle group-hover:bg-accent transition-colors duration-200 rounded-full">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class:list={[
                { "text-secondary": colored },
                "h-5 w-5",
                "group-hover:text-white transition-colors duration-200",
              ]}
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                clip-rule="evenodd"
              />
            </svg>
          </div>
          <div
            class={`
						${isLeft ? "timeline-start" : "timeline-end"} mb-8
						${isLeft ? "text-right md:text-right" : "text-left md:text-left"}
						group-hover:scale-105 transition-transform duration-200
						${isLeft ? "pr-2 md:pr-4" : "pl-2 md:pl-4"}
					`}
          >
            <time class="font-mono italic">{element.time}</time>
            {element.link ? (
              <a
                href={element.link}
                target="_blank"
                rel="noopener noreferrer"
                class="block hover:underline focus:underline"
              >
                <div class="text-lg font-black">
                  {isExperience(element) ? element.title : element.degree}
                </div>
              </a>
            ) : (
              <div class="text-lg font-black">
                {isExperience(element) ? element.title : element.degree}
              </div>
            )}
            <div
              class={`flex items-center ${isLeft ? "justify-end" : "justify-start"} gap-2`}
            >
              <span>
                {isExperience(element) ? element.company : element.school} ·{" "}
                {element.location}
              </span>
              {!isExperience(element) &&
                "courses" in element &&
                element.courses && (
                  <Tooltip content={element.courses}>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="h-4 w-4 text-gray-500 hover:text-gray-700 transition-colors cursor-help"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </Tooltip>
                )}
            </div>
            {"description" in element && element.description && (
              <div class="text-gray-600">{element.description}</div>
            )}
            {isExperience(element) &&
              "tags" in element &&
              element.tags &&
              element.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2 justify-start">
                  {element.tags.map((tag) => (
                    <span class="inline-flex items-center gap-2 rounded-full border border-base-300 bg-base-100 px-3 py-1.5 text-[0.72rem] font-semibold uppercase tracking-wide text-base-content/80 shadow-sm">
                      <span
                        class={`h-2.5 w-2.5 rounded-full ${getTagStyle(tag)}`}
                      />
                      <span>{formatTagLabel(tag)}</span>
                    </span>
                  ))}
                </div>
              )}
          </div>
          <hr
            class:list={[
              { "bg-secondary": colored },
              "transition-colors duration-200",
              "group-hover:bg-accent",
            ]}
          />
        </li>
      );
    })
  }
</ul>
