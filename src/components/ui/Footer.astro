---
import { execSync } from "node:child_process";
import { profile } from "../../settings";

const { fullName } = profile;

const repoOwner = "janiavdv";
const repoName = "janiavdv.github.io";

let commitHash = "";
let commitUrl = "";
let commitDate = "";

try {
  commitHash = execSync("git rev-parse --short HEAD").toString().trim();
  const commitIsoDate = execSync("git log -1 --format=%cI").toString().trim();
  commitUrl = `https://github.com/${repoOwner}/${repoName}/commit/${commitHash}`;
  commitDate = new Date(commitIsoDate).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
} catch {
  // git metadata unavailable (e.g. building outside a git checkout)
}
---

<div
  id="footer"
  class="max-w-[85rem] flex flex-col justify-center items-center mx-auto px-4 pt-28 sm:px-20 lg:px-40 mb-6"
>
  <p>Created & Maintained with ♡ by {fullName}.</p>
  <p class="text-base-content/60">Lock by trade, number eight when needed.</p>
  {
    commitHash && (
      <p id="last-updated">
        Last updated:{" "}
        <a
          href={commitUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-base-content underline decoration-base-content/40 hover:decoration-base-content font-mono"
        >
          {commitHash}
        </a>{" "}
        on {commitDate}
      </p>
    )
  }
</div>
