---
import Envelope from "@/assets/social-icons/envelope.svg";
import GitHub from "@/assets/social-icons/github.svg";
import LinkedIn from "@/assets/social-icons/linkedin-in.svg";

import { social } from "@/settings";

const iconSize = "size-5";
const containerSize = "size-9";
---

<div class="flex flex-wrap justify-between items-center">
  <!-- Email -->
  {
    social.email !== "" && (
      <a
        href={`mailto:${social.email}`}
        class={`${containerSize} inline-flex items-center justify-center rounded-lg text-base-content/70 hover:text-secondary transition-colors duration-200`}
      >
        <Envelope class={iconSize} fill="currentColor" />
      </a>
    )
  }

  <!-- GitHub -->
  {
    social.github !== "" && (
      <a
        href={social.github}
        target="_blank"
        class={`${containerSize} inline-flex items-center justify-center rounded-lg text-base-content/70 hover:text-secondary transition-colors duration-200`}
      >
        <GitHub class={iconSize} fill="currentColor" />
      </a>
    )
  }

  <!-- Linkedin -->
  {
    social.linkedin !== "" && (
      <a
        href={social.linkedin}
        target="_blank"
        class={`${containerSize} inline-flex items-center justify-center rounded-lg text-base-content/70 hover:text-secondary transition-colors duration-200`}
      >
        <LinkedIn class={iconSize} fill="currentColor" />
      </a>
    )
  }
</div>
