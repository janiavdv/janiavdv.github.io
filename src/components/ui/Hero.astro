---
import { Image } from "astro:assets";

import SocialIcons from "./SocialIcons.astro";
import OutsideWorkModal from "./OutsideWorkModal.astro";

const { fullName, title, institute, description, profilePicture } =
  Astro.props;

const instituteLabel = institute?.replace(/^the\s+/i, "");
---

<div class="flex flex-col-reverse sm:flex-row sm:items-start gap-8 w-full">
  <div class="flex-1">
    <h1 class="text-3xl md:text-4xl font-semibold tracking-tight mb-2">
      {fullName}
    </h1>
    {
      (title || instituteLabel) && (
        <p class="text-sm text-base-content/70 mb-6">
          {title}
          {title && instituteLabel && " · "}
          {instituteLabel}
        </p>
      )
    }
    <p class="text-base leading-relaxed text-base-content/80 mb-6">
      {description}
    </p>
    <div class="flex items-center gap-4 -ml-2">
      <SocialIcons />
      <span class="h-4 w-px bg-base-300"></span>
      <button
        type="button"
        data-open-outside-work
        class="text-sm text-base-content/70 underline underline-offset-4 decoration-secondary decoration-2 hover:text-base-content transition-colors"
      >
        Outside work
      </button>
    </div>
    <OutsideWorkModal />
  </div>
  <Image
    src={profilePicture}
    alt={fullName}
    class="size-28 md:size-36 rounded-full object-cover shrink-0"
  />
</div>
