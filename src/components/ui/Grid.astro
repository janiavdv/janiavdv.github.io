---
import type { Project, Skill } from "@/types/resume";
import { getTagStyle, formatTagLabel } from "@/data/tagStyles";

interface Props {
  gridTitle?: string;
  gridItems: (
    | Skill
    | Project
    | {
        title: string;
        description?: string;
        level?: number;
        company?: string;
        tags?: string[];
      }
  )[];
}

const { gridTitle, gridItems } = Astro.props;
---

{
  gridTitle && (
    <h2 class="text-xs font-semibold uppercase tracking-widest text-base-content/60 mb-2">
      {gridTitle}
    </h2>
  )
}
<div class="divide-y divide-base-300">
  {
    gridItems.map((item) => {
      const hasLink = "link" in item && Boolean(item.link);
      const isExperience = "company" in item && Boolean(item.company);
      const href = hasLink && typeof item.link === "string" ? item.link : undefined;
      const content = (
        <>
          <div class="flex items-baseline justify-between gap-4">
            <h3 class={`text-base font-medium transition-colors ${isExperience ? "" : "group-hover:text-secondary"}`}>
              {item.title}
              {hasLink && !isExperience && (
                <span
                  aria-hidden="true"
                  class="ml-1 text-base-content/40 group-hover:text-secondary"
                >
                  ↗
                </span>
              )}
            </h3>
            {"time" in item && item.time && (
              <div class="shrink-0 text-xs font-mono text-base-content/60">
                {item.time}
              </div>
            )}
          </div>
          {"company" in item && item.company && (
            <div class="text-sm text-base-content/60">
              {href ? (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-secondary transition-colors"
                >
                  {item.company} <span aria-hidden="true">↗</span>
                </a>
              ) : (
                item.company
              )}
            </div>
          )}
          {"description" in item && item.description && !("level" in item && item.level) && (
            <div class="mt-1 text-sm text-base-content/70">
              {item.description}
            </div>
          )}
          {"level" in item && item.level ? (
            <div class="mt-2 flex gap-1 w-24">
              {Array.from({ length: 5 }).map((_, idx) => (
                <div
                  class={`flex-1 h-1 rounded-full ${idx < (item.level ?? 0) ? "bg-secondary" : "bg-base-300"}`}
                />
              ))}
            </div>
          ) : null}
          {"tags" in item && item.tags && item.tags.length > 0 && (
            <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
              {item.tags.map((tag) => (
                <span class="inline-flex items-center gap-1.5 text-xs text-base-content/60 whitespace-nowrap">
                  <span class={`h-1.5 w-1.5 rounded-full ${getTagStyle(tag)}`} />
                  {formatTagLabel(tag)}
                </span>
              ))}
            </div>
          )}
        </>
      );

      const isExtraProject = "extra" in item && item.extra;

      return hasLink && !isExperience ? (
        <a
          href={typeof item.link === "string" ? item.link : undefined}
          class:list={["group block py-4", { hidden: isExtraProject }]}
          data-project-extra={isExtraProject ? "true" : "false"}
          target="_blank"
          rel="noopener noreferrer"
        >
          {content}
        </a>
      ) : (
        <div
          class:list={["group py-4", { hidden: isExtraProject }]}
          data-project-extra={isExtraProject ? "true" : "false"}
        >
          {content}
        </div>
      );
    })
  }
</div>
