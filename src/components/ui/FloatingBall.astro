---
import { Image } from "astro:assets";
import ball from "@/assets/rugby-ball.png";
---

<div class="floating-ball" aria-hidden="true">
  <Image src={ball} alt="" width={160} class="ball-img" />
</div>

<style>
  .floating-ball {
    position: fixed;
    top: 0;
    left: 0;
    width: 5rem;
    opacity: 0.55;
    pointer-events: none;
    z-index: 10;
    animation:
      drift-x 38s ease-in-out infinite alternate,
      drift-y 23s ease-in-out infinite alternate;
  }
  .floating-ball :global(.ball-img) {
    width: 100%;
    height: auto;
    animation: spin 18s linear infinite;
  }
  @keyframes drift-x {
    from { transform: translateX(4vw); }
    to { transform: translateX(calc(96vw - 5rem)); }
  }
  @keyframes drift-y {
    from { top: 12vh; }
    to { top: calc(88vh - 5rem); }
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-ball {
      display: none;
    }
  }
</style>
