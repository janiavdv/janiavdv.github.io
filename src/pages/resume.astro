---
import Layout from "@/layouts/Layout.astro";
import { experiences, education } from "../data/resume";
import ResumeTimeline from "@/components/ui/ResumeTimeline.astro";
import { template } from "@/settings";

import type { Experience, Education } from "../types/resume";

let orderedExperiences: Experience[] = [];
let orderedEducations: Education[] = [];

const orderElement = <T extends { time: string }>(a: T, b: T) => {
  const presentValues = ["present", "now", "current", "today"];
  if (
    presentValues.includes(
      (a["time"] as string)?.split(" - ")[1]?.toLowerCase(),
    )
  ) {
    // If the date is 'present', it should be the first element
    return -1;
  }
  const dateA = new Date((a["time"] as string)?.split(" - ")[1]);
  const dateB = new Date((b["time"] as string)?.split(" - ")[1]);
  return dateB.getTime() - dateA.getTime();
};

if (experiences.length > 0) {
  orderedExperiences = [...experiences].sort((a, b) => {
    return orderElement(a, b);
  });
}

if (education.length > 0) {
  orderedEducations = [...education].sort((a, b) => {
    return orderElement(a, b);
  });
}
---

<Layout title="Resume | Jania Vandevoorde">
  <div class="w-full flex items-baseline justify-between mb-10">
    <h1 class="text-3xl font-semibold tracking-tight">Resume</h1>
    <a
      href={`${template.base}/resume.pdf`}
      target="_blank"
      rel="noopener"
      class="text-sm text-base-content/70 hover:text-secondary transition-colors"
    >
      PDF ↗
    </a>
  </div>
  <div class="w-full">
    {
      orderedEducations.length > 0 && (
        <section class="mb-14">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-base-content/60 mb-2">
            Education
          </h2>
          <ResumeTimeline elements={orderedEducations} colored={true} />
        </section>
      )
    }

    {
      orderedExperiences.length > 0 && (
        <section class="mb-14">
          <div class="mb-2 flex items-center justify-between gap-4">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-base-content/60">
              Experience
            </h2>
            <label class="inline-flex items-center gap-2 text-xs text-base-content/60 cursor-pointer select-none">
              <span>Show non-technical</span>
              <input
                id="non-technical-toggle"
                type="checkbox"
                class="toggle toggle-xs toggle-secondary"
                aria-controls="experiences-container"
              />
            </label>
          </div>
          <div id="experiences-container">
            <ResumeTimeline elements={orderedExperiences} colored={true} />
          </div>
        </section>
      )
    }

    <a
      href={`${template.base}/projects`}
      class="text-sm text-base-content/70 hover:text-secondary transition-colors"
    >
      View projects →
    </a>
  </div>
  <script is:inline>
    const setupExperienceToggle = () => {
      const toggle = document.getElementById("non-technical-toggle");
      const experiences = document.querySelectorAll(
        '[data-experience-technical="false"]',
      );

      if (!toggle || experiences.length === 0) {
        return;
      }

      const applyState = () => {
        experiences.forEach((experience) => {
          experience.classList.toggle("hidden", !toggle.checked);
        });
      };

      applyState();
      toggle.addEventListener("change", applyState);
    };

    setupExperienceToggle();
    document.addEventListener("astro:page-load", setupExperienceToggle);
  </script>
</Layout>
