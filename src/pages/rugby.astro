---
import Layout from "@/layouts/Layout.astro";
import Grid from "@/components/ui/Grid.astro";
import { rugby } from "@/data/rugby";
import { template } from "@/settings";
---

<Layout title="Rugby | Jania Vandevoorde">
  <div class="max-w-3xl w-full mx-auto">
    <h1 class="text-4xl font-bold mb-2">Rugby</h1>
    <p class="text-lg italic text-base-content/70 mb-6">
      {rugby.years} years and counting
    </p>
    <p class="text-lg mb-8">
      I've played rugby for {rugby.years} years, mostly at
      <span class="text-secondary font-semibold">{rugby.positions[0]}</span>
      or
      <span class="text-secondary font-semibold">{rugby.positions[1]}</span>.
    </p>
    {
      rugby.highlights.length > 0 && (
        <section class="mb-12">
          <Grid gridTitle="Highlights" gridItems={rugby.highlights} />
        </section>
      )
    }
    <a
      href={`${template.base}/`}
      class="inline-block px-6 py-2 rounded-full bg-secondary text-ink hover:bg-accent transition-colors duration-200 text-center"
    >
      Back Home
    </a>
  </div>
</Layout>
