---
import Layout from "@/layouts/Layout.astro";
import { projects } from "@/data/resume";
import Grid from "@/components/ui/Grid.astro";

const ALL_PROJECTS = projects;
const VISIBLE_PROJECTS = ALL_PROJECTS.slice(0, 6);
const EXTRA_PROJECTS = ALL_PROJECTS.slice(6);
---

<Layout title="Projects | Jania Vandevoorde">
  <div class="max-w-none">
    <div class="border-b pb-4 mb-6">
      <h1 class="text-3xl font-bold">Technical Projects</h1>
    </div>
    <div id="projects-grid">
      <Grid gridItems={VISIBLE_PROJECTS} />
    </div>
    <div
      id="extra-projects-grid"
      class="overflow-hidden transition-[max-height,opacity] duration-300 ease-out"
      style="max-height: 0; opacity: 0;"
    >
      <div class="pt-0">
        <Grid gridItems={EXTRA_PROJECTS} />
      </div>
    </div>
    <div class="mt-6 flex justify-center">
      <button
        id="extra-projects-toggle"
        type="button"
        class="group inline-flex items-center px-4 py-2 bg-secondary text-white rounded-lg hover:bg-accent transition"
        aria-controls="extra-projects-grid"
        aria-expanded="false"
      >
        <span
          class="inline-flex items-center justify-center w-8 h-8 bg-secondary rounded-full mr-2 transition group-hover:bg-accent"
        >
          <svg
            id="extra-projects-toggle-icon"
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 transition-transform duration-200 group-hover:scale-125"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              id="extra-projects-toggle-icon-path"
              d="M12 5v14M5 12h14"
              class="transition stroke-white group-hover:stroke-white"></path>
          </svg>
        </span>
        <span id="extra-projects-toggle-label">Show more</span>
      </button>
    </div>
  </div>
  <script is:inline>
    const toggle = document.getElementById("extra-projects-toggle");
    const extraProjects = document.querySelectorAll(
      '[data-project-extra="true"]',
    );
    const extraProjectsGrid = document.getElementById("extra-projects-grid");
    const toggleLabel = document.getElementById("extra-projects-toggle-label");
    const toggleIconPath = document.getElementById(
      "extra-projects-toggle-icon-path",
    );
    let collapseTimer;

    if (toggle) {
      const applyState = (isExpanded) => {
        if (collapseTimer) {
          window.clearTimeout(collapseTimer);
          collapseTimer = undefined;
        }

        toggle.setAttribute("aria-expanded", String(isExpanded));

        if (extraProjectsGrid) {
          if (isExpanded) {
            extraProjects.forEach((project) => {
              project.classList.remove("hidden");
            });

            extraProjectsGrid.style.maxHeight = "0px";
            extraProjectsGrid.style.opacity = "0";

            window.requestAnimationFrame(() => {
              extraProjectsGrid.style.maxHeight = `${extraProjectsGrid.scrollHeight}px`;
              extraProjectsGrid.style.opacity = "1";
            });
          } else {
            extraProjectsGrid.style.maxHeight = "0px";
            extraProjectsGrid.style.opacity = "0";

            collapseTimer = window.setTimeout(() => {
              extraProjects.forEach((project) => {
                project.classList.add("hidden");
              });
            }, 300);
          }
        }
        if (toggleLabel) {
          toggleLabel.textContent = isExpanded ? "Show less" : "Show more";
        }
        if (toggleIconPath) {
          toggleIconPath.setAttribute(
            "d",
            isExpanded ? "M5 12h14" : "M12 5v14M5 12h14",
          );
        }
      };

      applyState(false);
      toggle.addEventListener("click", () => {
        const isExpanded = toggle.getAttribute("aria-expanded") === "false";
        applyState(isExpanded);
      });
    }
  </script>
</Layout>
