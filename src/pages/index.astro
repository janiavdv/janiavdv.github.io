---
import Layout from "../layouts/Layout.astro";

import { profile, template } from "@/settings";
import { projects } from "@/data/resume";
import { experiences } from "@/data/resume";
import ProfilePictures from "@/assets/profile_picture.jpg";
import Hero from "@/components/ui/Hero.astro";
import Grid from "@/components/ui/Grid.astro";

const { fullName, title, institute, description, interests } = profile;

const recentWorkExperiences = experiences
  .filter((exp) => exp.featured)
  .sort((a, b) => {
    const presentValues = ["present", "now", "current", "today"];
    const aEnd = (a.time as string)?.split(" - ")[1]?.toLowerCase();
    const bEnd = (b.time as string)?.split(" - ")[1]?.toLowerCase();

    if (presentValues.includes(aEnd ?? "")) {
      return -1;
    }

    if (presentValues.includes(bEnd ?? "")) {
      return 1;
    }

    return new Date(bEnd ?? "").getTime() - new Date(aEnd ?? "").getTime();
  });
---

<Layout>
  <!-- Hero Section -->
  <section class="flex items-center gap-12 border-b pb-12">
    <Hero
      fullName={fullName}
      title={title}
      institute={institute}
      description={description}
      profilePicture={ProfilePictures}
    />
  </section>

  <!-- Recent Work Experience -->
  <section class="py-12 border-t">
    <Grid
      gridTitle="Recent Work Experience"
      gridItems={recentWorkExperiences}
    />
    <div class="mt-8 flex justify-center">
      <a
        href={`${template.base}/resume`}
        class="inline-block px-6 py-2 rounded-full bg-secondary text-ink hover:bg-accent transition-colors duration-200 text-center"
      >
        More Experience
      </a>
    </div>
  </section>

  <!-- Recent Projects -->
  <section class="py-12 border-t">
    <Grid gridTitle="Recent Projects" gridItems={projects.slice(0, 3)} />
    <div class="mt-8 flex justify-center">
      <a
        href={`${template.base}/projects`}
        class="inline-block px-6 py-2 rounded-full bg-secondary text-ink hover:bg-accent transition-colors duration-200 text-center"
      >
        More Projects
      </a>
    </div>
  </section>

  <!-- Off the pitch -->
  <section class="py-12 border-t border-dashed border-base-content/15 w-full">
    <h2 class="text-2xl md:text-3xl font-bold mb-4 md:mb-6">Off the pitch</h2>
    <p class="text-base md:text-lg max-w-3xl">
      I've played rugby for 11 years, mostly at <span class="text-secondary font-semibold">lock (#5)</span> or <span class="text-secondary font-semibold">number eight (#8)</span>. It taught me to show up for the people next to me, keep working when it's ugly, and trust a plan that only works if everyone does their job.
    </p>
  </section>

  <!-- Interests -->
  {
    interests.length > 0 && (
      <section class="py-12 border-b">
        <Grid gridTitle="Interests" gridItems={interests} />
      </section>
    )
  }
</Layout>
