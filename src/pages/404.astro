---
import Layout from "@/layouts/Layout.astro";
import { template } from "@/settings";
---

<Layout title="404 - Page Not Found">
  <div
    class="min-h-[70vh] flex flex-col items-center justify-center text-center"
  >
    <h1 class="text-7xl font-semibold tracking-tight text-secondary mb-4">404</h1>
    <h2 class="text-xl font-medium text-base-content mb-4">Page not found</h2>
    <p class="text-base text-base-content/70 mb-8">
      Looks like this page went on a coffee break.<br />
      Don't worry, you can always find your way back home.
    </p>
    <div class="flex gap-6">
      <a
        href={`${template.base}/`}
        class="text-sm underline underline-offset-4 decoration-secondary decoration-2 hover:text-secondary transition-colors"
      >
        Go home
      </a>
      <button
        type="button"
        class="text-sm text-base-content/70 hover:text-secondary transition-colors"
        onclick="history.back()"
      >
        Go back
      </button>
    </div>
  </div>
</Layout>
