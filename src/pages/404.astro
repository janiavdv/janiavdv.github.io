---
import Layout from "@/layouts/Layout.astro";
import { template } from "@/settings";
---

<Layout title="404 - Page Not Found">
  <div
    class="min-h-[70vh] flex flex-col items-center justify-center text-center"
  >
    <h1 class="text-9xl font-black text-base-content mb-4">404</h1>
    <h2 class="text-4xl font-bold text-base-content mb-8">Page Not Found</h2>
    <p class="text-lg text-base-content/80 mb-8">
      Looks like this page went on a coffee break. ☕<br />
      Don't worry, you can always find your way back home.
    </p>
    <div class="flex gap-4">
      <a
        href={`${template.base}/`}
        class="inline-block px-6 py-2 rounded-full bg-secondary text-ink hover:bg-accent transition-colors duration-200 text-center"
      >
        Go Home
      </a>
      <button
        type="button"
        class="inline-block px-6 py-2 rounded-full border border-base-300 text-base-content hover:bg-secondary/20 transition-colors duration-200 text-center"
        onclick="history.back()"
      >
        Go Back
      </button>
    </div>
  </div>
</Layout>
